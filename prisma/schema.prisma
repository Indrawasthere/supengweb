generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum UserRole {
  L2
  LEAD
  L1_TS
  ADMIN
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash  String
  role           UserRole

  // Used to match GLPI "Assigned To - Technician Group" (e.g. team key/name)
  teamKey        String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions       Session[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash    String   @unique
  expiresAt    DateTime

  createdAt    DateTime @default(now())
}

